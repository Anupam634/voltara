# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matsumoto?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── Auth ───────────────────────────────────────────────
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# ─── Chain (BNB) ────────────────────────────────────────
# WALLET_MODE: offchain | testnet | mainnet
WALLET_MODE="offchain"
BSC_RPC_URL="https://bsc-dataseed.binance.org/"
BSC_TESTNET_RPC_URL="https://data-seed-prebsc-1-s1.binance.org:8545/"
MATSUMOTO_CONTRACT_ADDRESS=""   # real BEP-20 address (from client) — required for mainnet
MATSUMOTO_DECIMALS="18"
HOT_WALLET_PRIVATE_KEY=""       # payout wallet — KEEP SECRET, never commit

# ─── Reward economics (mirror of SPEC.md) ───────────────
BASE_RATE_PER_HOUR="0.9"
POINTS_PER_MAINNET_TOKEN="3"    # 3 points = 1 $Matsumoto
MIN_WITHDRAWAL_POINTS="100"
WITHDRAWAL_COOLDOWN_DAYS="7"
MINE_CLAIM_COOLDOWN_HOURS="24"

# ─── Anti-abuse (SPEC §7) ───────────────────────────────
MAX_ACCOUNTS_PER_DEVICE="3"     # signups allowed per device fingerprint
MAX_ACCOUNTS_PER_IP="5"         # signups allowed per IP address

# ─── Booster payments (on-chain, auto-verified) ─────────
# Address users pay into. Leave blank to keep booster purchases disabled.
BOOSTER_PAY_TO_ADDRESS=""
# USDT (a dollar stablecoin maps 1:1 to the USD plan prices) or BNB.
BOOSTER_PAY_TOKEN="USDT"
# BEP-20 contract of the accepted token. BSC-USDT mainnet:
#   0x55d398326f99059fF775485246999027B3197955  (18 decimals)
BOOSTER_PAY_TOKEN_ADDRESS=""
BOOSTER_PAY_TOKEN_DECIMALS="18"
# Only needed when BOOSTER_PAY_TOKEN=BNB — how much BNB equals $1. Without
# it BNB payments stay disabled rather than being priced by a guessed rate.
BOOSTER_BNB_PER_USD=""
# Confirmations required before a payment is accepted.
BOOSTER_MIN_CONFIRMATIONS="6"
# Defaults to BSC_RPC_URL when unset.
BOOSTER_RPC_URL=""

# First admin panel login, created at boot when both are set. There is no
# admin self-signup, and hosts without shell access cannot run the CLI, so
# this is how a fresh deployment gets into its own admin panel.
# ADMIN_PASSWORD is the source of truth: change it and redeploy to rotate.
ADMIN_EMAIL="matsumoto@gmail.com"
ADMIN_PASSWORD="matsumoto@123456"          # minimum 12 characters, or it is refused
