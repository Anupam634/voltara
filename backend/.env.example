# ─── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bondkoin?schema=public"
# Also backs pending OTP codes. Unset = in-memory, lost on every restart.
REDIS_URL="redis://localhost:6379"

# ─── Auth & Security ─────────────────────────────────────────
# REQUIRED. The API refuses to start without it — there is no fallback, and
# the two example values that used to live here are rejected explicitly.
# Generate with: openssl rand -hex 32
# Miner and admin tokens are both signed with this key, so leaking it means
# someone can mint an admin token.
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
# Browser origins allowed to call this API, comma separated. Leave unset to
# use the defaults in src/common/cors-origins.ts. Add preview/staging hosts
# here — anything not listed is refused by the browser.
CORS_ORIGINS="https://bondkoinlabs.com,https://www.bondkoinlabs.com,http://localhost:3000"

# ─── Chain (BNB Smart Chain) ─────────────────────────────────
# WALLET_MODE: offchain | testnet | mainnet
WALLET_MODE="offchain"
BSC_RPC_URL="https://bsc-dataseed1.binance.org/"
BSC_TESTNET_RPC_URL="https://data-seed-prebsc-1-s1.binance.org:8545/"
BONDKOIN_CONTRACT_ADDRESS=""   # Your BEP-20 token address (required for mainnet payouts)
BONDKOIN_DECIMALS="18"
HOT_WALLET_PRIVATE_KEY=""       # Payout wallet private key — KEEP SECRET, never commit

# ─── Reward Economics ────────────────────────────────────────
BASE_RATE_PER_HOUR="0.9"
POINTS_PER_MAINNET_TOKEN="3"    # 3 points = 1 $BONDKOIN
MIN_WITHDRAWAL_POINTS="100"
WITHDRAWAL_COOLDOWN_DAYS="7"
MINE_CLAIM_COOLDOWN_HOURS="24"

# ─── Anti-Abuse Protection ───────────────────────────────────
MAX_ACCOUNTS_PER_DEVICE="3"     # Max signups allowed per device fingerprint
MAX_ACCOUNTS_PER_IP="5"         # Max signups allowed per IP address

# ─── Booster Payments (On-Chain BEP-20 Verification) ─────────
# Your receiving wallet address on BNB Chain. When set, users can buy boosters.
BOOSTER_PAY_TO_ADDRESS="0x8E1A28572f4A0EB9699BCf2a3d93eCa5417Ab96c"
# Accepted token: USDT (1:1 USD) or BNB
BOOSTER_PAY_TOKEN="USDT"
# Official USDT contract address on BNB Smart Chain Mainnet:
BOOSTER_PAY_TOKEN_ADDRESS="0x55d398326f99059fF775485246999027B3197955"
BOOSTER_PAY_TOKEN_DECIMALS="18"
BOOSTER_MIN_CONFIRMATIONS="6"
BOOSTER_RPC_URL="https://bsc-dataseed1.binance.org/"

# ─── Initial Admin Account ───────────────────────────────────
# Created automatically on boot if no admin exists yet.
ADMIN_EMAIL="admin@bondkoinlabs.com"
ADMIN_PASSWORD="BondKoin@2026!Admin" # Minimum 12 characters required

# ─── Real Email Delivery (Spacemail / Custom Domain SMTP) ────
# Configure your SMTP credentials for real 6-digit OTP delivery on Signup, 2FA, & Password Reset:
SMTP_HOST="mail.spacemail.com"
SMTP_PORT="465"
SMTP_USER="hello@bondkoinlabs.com"
SMTP_PASS="your-spacemail-password"
SMTP_FROM="\"BONDKOIN Labs\" <hello@bondkoinlabs.com>"

# Social bounties (Tasks & Bounties). Admins can override per task in the admin panel.
WEB_URL=https://bondkoinlabs.com
X_HANDLE=BondKoin
# Full URL of the pinned post to repost, e.g. https://x.com/BondKoin/status/1234567890
X_PINNED_POST_URL=https://x.com/BondKoin
