# ─── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voltara?schema=public"
# Also backs pending OTP codes. Unset = in-memory, lost on every restart.
REDIS_URL="redis://localhost:6379"

# ─── Auth & Security ─────────────────────────────────────────
# REQUIRED. The API refuses to start without it — there is no fallback, and
# the two example values that used to live here are rejected explicitly.
# Generate with: openssl rand -hex 32
# Miner and admin tokens are both signed with this key, so leaking it means
# someone can mint an admin token.
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
# Browser origins allowed to call this API, comma separated. Leave unset to
# use the defaults in src/common/cors-origins.ts. Add preview/staging hosts
# here — anything not listed is refused by the browser.
CORS_ORIGINS="https://voltaragrid.com,https://www.voltaragrid.com,http://localhost:3000"

# ─── Chain (BNB Smart Chain) ─────────────────────────────────
# WALLET_MODE: offchain | testnet | mainnet
WALLET_MODE="offchain"
BSC_RPC_URL="https://bsc-dataseed1.binance.org/"
BSC_TESTNET_RPC_URL="https://data-seed-prebsc-1-s1.binance.org:8545/"
VLTR_CONTRACT_ADDRESS=""   # Your BEP-20 token address (required for mainnet payouts)
VLTR_DECIMALS="18"
HOT_WALLET_PRIVATE_KEY=""       # Payout wallet private key — KEEP SECRET, never commit

# ─── Payout window ───────────────────────────────────────────
# Withdrawals are CLOSED unless one of these opens them. Accepting a request
# debits the miner's balance into escrow, so before $VLTR exists a queued
# request is balance nobody can release. Flip PAYOUTS_OPEN to "true" on
# launch day, or set the date ahead of time and let it open itself.
# An explicit PAYOUTS_OPEN="false" always wins — it is the kill switch.
PAYOUTS_OPEN="false"
PAYOUTS_OPEN_AT=""              # e.g. "2026-12-01T00:00:00Z" (optional)

# ─── Identity verification window ────────────────────────────
# KYC gates exactly one thing — the withdrawal request — and that path
# already refuses everyone while payouts are shut. So documents are NOT
# collected by default: holding people's passports before there is anything
# to verify for is a liability, not a feature.
#
# Leave both blank and KYC simply follows the payout window above, which is
# what you want: opening payouts without opening KYC would make every
# withdrawal fail on "KYC must be approved" with no way to comply.
# Set KYC_OPEN="true" only to deliberately verify AHEAD of launch and spread
# the review load. The admin review queue stays open either way.
KYC_OPEN=""                     # "" = follow payouts | "true" | "false"
KYC_OPEN_AT=""                  # e.g. "2026-11-15T00:00:00Z" (optional)

# ─── Reward Economics ────────────────────────────────────────
# These are NOT environment variables. The rate, the conversion ratio, the
# withdrawal minimum and both cooldowns are constants in code, and the five
# keys that used to sit here were read by nothing — setting BASE_RATE_PER_HOUR
# in production changed no rate. A knob that looks connected and is not is
# worse than no knob, so they are gone. The real values live in:
#   BASE_RATE_MILLI, CLAIM_WINDOW_HOURS   src/mining/mining.engine.ts
#   WITHDRAWAL_MIN_POINTS, POINTS_PER_TOKEN, COOLDOWN_MS
#                                         src/withdrawals/withdrawals.service.ts

# ─── Anti-Abuse Protection ───────────────────────────────────
MAX_ACCOUNTS_PER_DEVICE="3"     # Max signups allowed per device fingerprint
MAX_ACCOUNTS_PER_IP="5"         # Max signups allowed per IP address

# ─── Booster Payments (On-Chain BEP-20 Verification) ─────────
# Your receiving wallet address on BNB Chain. When set, users can buy boosters.
BOOSTER_PAY_TO_ADDRESS="0x8E1A28572f4A0EB9699BCf2a3d93eCa5417Ab96c"
# Accepted token: USDT (1:1 USD) or BNB
BOOSTER_PAY_TOKEN="USDT"
# Official USDT contract address on BNB Smart Chain Mainnet:
BOOSTER_PAY_TOKEN_ADDRESS="0x55d398326f99059fF775485246999027B3197955"
BOOSTER_PAY_TOKEN_DECIMALS="18"
BOOSTER_MIN_CONFIRMATIONS="6"
BOOSTER_RPC_URL="https://bsc-dataseed1.binance.org/"

# ─── Initial Admin Account ───────────────────────────────────
# Created automatically on boot if no admin exists yet.
ADMIN_EMAIL="admin@voltaragrid.com"
ADMIN_PASSWORD="Voltara@2026!Admin" # Minimum 12 characters required

# ─── Real Email Delivery (Spacemail / Custom Domain SMTP) ────
# Configure your SMTP credentials for real 6-digit OTP delivery on Signup, 2FA, & Password Reset:
SMTP_HOST="mail.spacemail.com"
SMTP_PORT="465"
SMTP_USER="hello@voltaragrid.com"
SMTP_PASS="your-spacemail-password"
SMTP_FROM="\"VOLTARA Labs\" <hello@voltaragrid.com>"

# Social bounties (Tasks & Bounties). Admins can override per task in the admin panel.
WEB_URL=https://voltaragrid.com
X_HANDLE=Voltara
# Full URL of the pinned post to repost, e.g. https://x.com/VoltaraGrid/status/1234567890
X_PINNED_POST_URL=https://x.com/VoltaraGrid
