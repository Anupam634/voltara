// Matsumoto Mining Platform — data model
// See SPEC.md for the rules these tables encode.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Users ───────────────────────────
model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  walletAddress String?  @unique
  passwordHash  String?
  countryCode   String? // ISO-2, for admin per-country counts
  isBlocked     Boolean  @default(false)
  createdAt     DateTime @default(now())

  // balances are stored as integer "milli-points" to avoid float drift
  // (1 point = 1000 units). Helpers convert to/from decimal.
  pointsBalance BigInt @default(0)

  // referral graph
  referralCode String  @unique @default(cuid())
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  // last successful "Mine" tap — gates the 24h cooldown & accrual window
  lastMineAt DateTime?

  // Manual hash-rate adjustment from the admin panel (SPEC §6), in
  // milli-points/hour. Signed: negative throttles a suspected abuser.
  rateAdjustMilli Int @default(0)

  kyc              KycRecord?
  boosters         Booster[]
  taskClaims       TaskClaim[]
  withdrawals      Withdrawal[]
  boosterPurchases BoosterPurchase[]
  ledger           LedgerEntry[]
  devices          DeviceFingerprint[]
  supportTickets   SupportTicket[]

  @@index([referredById])
  @@index([countryCode])
}

// ─────────────────────────── KYC ─────────────────────────────
enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum KycDocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
}

model KycRecord {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  status    KycStatus @default(NONE)
  provider  String? // e.g. "sumsub"; "manual" for in-house review
  reference String? // provider-side applicant id
  updatedAt DateTime  @updatedAt

  // ── Manual review (no third-party provider chosen yet, SPEC §9b.4) ──
  fullName       String?
  documentType   KycDocumentType?
  documentNumber String?
  countryCode    String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewerNote   String?

  documents KycDocument[]
}

// An uploaded identity image, held as a base64 data payload.
//
// Kept in its own table so listing KYC records never drags image blobs into
// memory — they are only read on the single-applicant view. This is a
// stopgap for manual review: a real deployment should move these to object
// storage (or a KYC provider) rather than keep documents in the app database.
model KycDocument {
  id        String    @id @default(cuid())
  recordId  String
  record    KycRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  kind      String // "front" | "back" | "selfie"
  mimeType  String
  data      String    @db.Text // base64, size-capped at the API boundary
  createdAt DateTime  @default(now())

  @@index([recordId])
}

// ─────────────────────── Booster plans ───────────────────────
// Catalogue of purchasable plans (seeded from SPEC.md table).
model BoosterPlan {
  id             String            @id @default(cuid())
  priceUsd       Int // 1, 5, 10, 50
  // rate CONTRIBUTION added on top of base, in milli-points/hour.
  // $1 => resulting 2.9 from 0.9 base => +2.0/hr => 2000 milli.
  rateBonusMilli Int
  durationDays   Int               @default(30)
  active         Boolean           @default(true)
  boosters       Booster[]
  purchases      BoosterPurchase[]
}

enum BoosterPurchaseStatus {
  AWAITING_PAYMENT
  CONFIRMED
  FAILED
  EXPIRED
}

// An on-chain payment intent for a booster plan. Created before the user
// pays so the expected amount, recipient and payer wallet are all pinned;
// the transaction is then verified against those pinned values.
model BoosterPurchase {
  id              String                @id @default(cuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id])
  planId          String
  plan            BoosterPlan           @relation(fields: [planId], references: [id])
  status          BoosterPurchaseStatus @default(AWAITING_PAYMENT)
  tokenSymbol     String
  // Smallest-unit amount required, as a decimal string (bigint-safe).
  expectedUnits   String
  // Human-readable amount for the payment instructions, e.g. "5.0".
  expectedAmount  String
  payToAddress    String
  // Wallet the user declared they will pay from. Verification requires the
  // transaction's sender to match, so a stranger's tx hash cannot be claimed.
  fromAddress     String
  // Only ever set on a CONFIRMED purchase, and unique — so one transaction
  // can fund exactly one booster. Deliberately NOT written on failure: a
  // rejected attempt must leave the payer free to re-submit the same real
  // payment against a corrected purchase.
  txHash          String?               @unique
  // Last hash the user tried, kept for support. Non-unique on purpose.
  attemptedTxHash String?
  failureReason   String?
  confirmedAt     DateTime?
  createdAt       DateTime              @default(now())
  expiresAt       DateTime
  booster         Booster?

  @@index([userId])
  @@index([status])
}

model Booster {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  planId     String
  plan       BoosterPlan      @relation(fields: [planId], references: [id])
  startedAt  DateTime         @default(now())
  expiresAt  DateTime
  txHash     String? // on-chain payment reference
  createdAt  DateTime         @default(now())
  purchaseId String?          @unique
  purchase   BoosterPurchase? @relation(fields: [purchaseId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────── Tasks ───────────────────────────
enum TaskType {
  TWEET
  FOLLOW
  REPOST
  YOUTUBE
  QUIZ
  SPIN_WHEEL
}

model Task {
  id            String      @id @default(cuid())
  type          TaskType
  title         String
  rewardMilli   Int // point reward in milli-points
  cooldownHours Int         @default(24)
  active        Boolean     @default(true)
  claims        TaskClaim[]
}

model TaskClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  claimedAt DateTime @default(now())
  verified  Boolean  @default(false)

  @@index([userId, taskId])
}

// ─────────────────────── Withdrawals ─────────────────────────
enum WithdrawalStatus {
  PENDING // awaiting admin approval
  APPROVED // approved, queued for payout
  PAID // on-chain tx confirmed
  REJECTED
}

model Withdrawal {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  pointsAmount BigInt // milli-points debited
  tokenAmount  String // $Matsumoto (points/3), decimal string
  toAddress    String
  status       WithdrawalStatus @default(PENDING)
  txHash       String?
  adminNote    String?
  requestedAt  DateTime         @default(now())
  resolvedAt   DateTime?

  @@index([userId])
  @@index([status])
}

// ───────────────────── Accounting ledger ─────────────────────
enum LedgerReason {
  MINING
  TASK_REWARD
  REFERRAL_BONUS
  BOOSTER_PURCHASE
  WITHDRAWAL
  AIRDROP
  ADMIN_ADJUST
}

model LedgerEntry {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  reason     LedgerReason
  deltaMilli BigInt // signed change to pointsBalance
  meta       Json?
  createdAt  DateTime     @default(now())

  @@index([userId, createdAt])
}

// ─────────────────── Anti-abuse signals ──────────────────────
model DeviceFingerprint {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  fingerprint String
  lastIp      String?
  seenAt      DateTime @default(now())

  @@index([fingerprint])
  @@index([lastIp])
}

// ─────────────────────────── Admin ───────────────────────────
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

// ────────────────────────── Support ──────────────────────────
enum SupportStatus {
  OPEN // waiting on an operator
  ANSWERED // operator replied, waiting on the miner
  CLOSED
}

// A support conversation. The thread lives in SupportMessage so both sides
// can reply more than once; the ticket itself only tracks the subject and
// where the conversation currently stands.
model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  subject   String
  status    SupportStatus    @default(OPEN)
  messages  SupportMessage[]
  createdAt DateTime         @default(now())
  // Bumped on every message so the operator queue can sort by staleness.
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([status, updatedAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Distinguishes an operator reply from the miner's own message.
  fromAdmin Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}
