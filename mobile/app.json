{
  "expo": {
    "name": "VOLTARA",
    "slug": "volta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "voltara",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#7C3AED",
    "backgroundColor": "#07060B",
    "description": "Build a mining rig on BNB Chain. Socket cores, coolers and PSUs into six slots, keep grid stability at 100%, and withdraw $VLTR to your own wallet.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voltaragrid.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "VOLTARA uses the camera so you can photograph your ID document and take a selfie for identity verification.",
        "NSPhotoLibraryUsageDescription": "VOLTARA needs access to your photos so you can attach your ID document and selfie for identity verification.",
        "NSFaceIDUsageDescription": "VOLTARA uses Face ID to unlock the app when App Lock is enabled."
      },
      "associatedDomains": [
        "applinks:voltaragrid.com",
        "applinks:www.voltaragrid.com"
      ]
    },
    "android": {
      "package": "com.voltaragrid.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07060B"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "voltaragrid.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.voltaragrid.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/mark.png",
          "color": "#A3E635",
          "defaultChannel": "mining"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VOLTARA needs access to your photos so you can attach your ID document and selfie for identity verification.",
          "cameraPermission": "VOLTARA uses the camera so you can photograph your ID document and take a selfie for identity verification."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "VOLTARA uses Face ID to unlock the app when App Lock is enabled."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#07060B",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#07060B"
          }
        }
      ],
      "expo-localization",
      "expo-audio",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "https://api.voltaragrid.com/api",
      "webUrl": "https://voltaragrid.com",
      "router": {},
      "eas": {
        "projectId": "69a3ed01-b62a-4906-849d-993df652e733"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "anupam634"
  }
}
